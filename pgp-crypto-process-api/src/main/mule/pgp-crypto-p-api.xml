    <apikit:config name="pgp-crypto-p-api-config" api="resource::07dfe689-07a4-495f-abd4-970b9770dd7d:pgp-crypto-p-api:1.0.0:raml:zip:pgp-crypto-p-api.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
	<flow name="pgp-crypto-p-api-main" doc:id="544737ee-f1e1-4708-9c6d-242e1e9ccd55">
        <http:listener path="/api/*" config-ref="HTTP_Listener_config">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="pgp-crypto-p-api-config" />
		<error-handler ref="global-error-handlingError_Handler" />
    </flow>
